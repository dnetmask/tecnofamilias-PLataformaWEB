generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  USER
  ADMIN
}

/// Etapas de edad usadas en toda la plataforma (diapositiva 10 de la presentación).
enum AgeStage {
  ALL
  AGE_0_5
  AGE_6_10
  AGE_11_13
  AGE_14_17
}

/// Todo el contenido requiere suscripción; los complementos además se compran aparte.
enum LessonAccess {
  INCLUDED // incluida en la suscripción
  ADDON // complemento: suscripción activa + pago adicional único
}

enum PlanInterval {
  MONTH
  YEAR
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

enum OrderKind {
  SUBSCRIPTION
  LESSON
  SERVICE
  RESOURCE
}

/// Público al que va dirigido un servicio adicional.
enum ServiceAudience {
  FAMILIAS
  COLEGIOS
  EMPRESAS
  GOBIERNO
}

enum ServiceRequestStatus {
  NEW // cotización solicitada, sin atender
  PAID // servicio pagado en línea, falta agendar
  CONTACTED // el equipo ya contactó al cliente
  WON // contratado / agendado
  LOST // no se concretó
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ResourceKind {
  VIDEO
  PODCAST
  BOOK
  EBOOK
  DOCUMENT
  SOFTWARE
  HARDWARE
}

/// Cómo se accede a una herramienta de la Caja de herramientas.
enum ResourceAccess {
  FREE // libre acceso, sin cuenta
  SUBSCRIPTION // incluida en la suscripción
  PAID // pago adicional a la suscripción, dentro de la plataforma
  EXTERNAL // se compra por fuera (tienda del fabricante, librería, etc.)
}

enum PactStatus {
  DRAFT
  PARENT_SIGNED
  SIGNED
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String
  role            Role      @default(USER)
  active          Boolean   @default(true)
  acceptedTermsAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  subscription      Subscription?
  purchases         Purchase[]
  orders            Order[]
  serviceRequests   ServiceRequest[]
  resourcePurchases ResourcePurchase[]
  resourceFavorites ResourceFavorite[]
  resourceUses      ResourceUse[]
  pacts             Pact[]
  threads           ForumThread[]
  posts             ForumPost[]
  reports           ForumReport[]
}

model Plan {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String       @default("")
  /// Precio base en dólares; se convierte a COP al pagar.
  priceUsd    Int
  /// Precio fijo en COP (opcional); si existe reemplaza la conversión del dólar.
  priceCop    Int?
  interval    PlanInterval
  active      Boolean      @default(true)
  order       Int          @default(0)
  createdAt   DateTime     @default(now())

  subscriptions Subscription[]
  orders        Order[]
}

/// Suscripción prepagada: cada pago aprobado extiende currentPeriodEnd.
model Subscription {
  id               String             @id @default(cuid())
  userId           String             @unique
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId           String?
  plan             Plan?              @relation(fields: [planId], references: [id], onDelete: SetNull)
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime
  grantedByAdmin   Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model Lesson {
  id           String       @id @default(cuid())
  slug         String       @unique
  title        String
  summary      String
  description  String       @default("")
  ageStage     AgeStage     @default(ALL)
  access       LessonAccess @default(INCLUDED)
  /// Precio del complemento en dólares.
  priceUsd     Int          @default(0)
  videoUrl     String       @default("")
  thumbnailUrl String       @default("")
  durationMin  Int          @default(0)
  instructor   String       @default("")
  published    Boolean      @default(false)
  order        Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  purchases Purchase[]
  orders    Order[]
}

model Purchase {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  orderId   String?  @unique
  createdAt DateTime @default(now())

  @@unique([userId, lessonId])
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        OrderKind
  planId      String?
  plan        Plan?       @relation(fields: [planId], references: [id], onDelete: SetNull)
  lessonId    String?
  lesson      Lesson?     @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  serviceId   String?
  service     Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  resourceId  String?
  resource    Resource?   @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  description String
  /// Monto cobrado en COP (lo que se envía a Mercado Pago).
  amountCop   Int
  /// Precio base en dólares y tasa usada para convertirlo (COP por USD).
  amountUsd   Int?
  fxRate      Float?
  status      OrderStatus @default(PENDING)
  provider    String
  providerRef String?
  createdAt   DateTime    @default(now())
  paidAt      DateTime?

  @@index([userId])
}

/// Herramienta de la Caja de herramientas (video, podcast, libro, ebook,
/// documento, software o hardware).
model Resource {
  id          String         @id @default(cuid())
  slug        String         @unique
  kind        ResourceKind
  title       String
  author      String         @default("")
  description String         @default("")
  url         String
  imageUrl    String         @default("")
  ageStage    AgeStage       @default(ALL)
  access      ResourceAccess @default(SUBSCRIPTION)
  /// PAID: precio de la compra en línea. EXTERNAL: precio de referencia (0 = no se muestra).
  priceUsd    Int            @default(0)
  /// Precio fijo en COP (opcional); si existe reemplaza la conversión del dólar.
  priceCop    Int?
  /// Familias distintas que la han usado (abierto, visto o descargado).
  uses        Int            @default(0)
  published   Boolean        @default(true)
  order       Int            @default(0)
  createdAt   DateTime       @default(now())

  orders    Order[]
  purchases ResourcePurchase[]
  favorites ResourceFavorite[]
  useLog    ResourceUse[]

  @@index([uses])
}

model ResourcePurchase {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  orderId    String?  @unique
  createdAt  DateTime @default(now())

  @@unique([userId, resourceId])
}

model ResourceFavorite {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, resourceId])
}

/// Primera vez que cada usuario usa una herramienta (alimenta Resource.uses).
model ResourceUse {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, resourceId])
}

model PactTemplate {
  id          String   @id @default(cuid())
  slug        String   @unique
  appName     String
  description String   @default("")
  color       String   @default("#3DAEE4")
  minAge      Int      @default(0)
  /// Lista de cláusulas sugeridas (string[])
  clauses     Json
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  pacts Pact[]
}

model Pact {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId      String?
  template        PactTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  appName         String
  childName       String
  childAge        Int?
  parentName      String
  /// Cláusulas acordadas (string[])
  clauses         Json
  rewards         String        @default("")
  consequences    String        @default("")
  reviewDate      DateTime?
  status          PactStatus    @default(DRAFT)
  parentSignature String?
  parentSignedAt  DateTime?
  childSignature  String?
  childSignedAt   DateTime?
  /// Token para que el hijo firme desde su propio dispositivo.
  shareToken      String        @unique @default(cuid())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
}

model ForumCategory {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String        @default("")
  order       Int           @default(0)
  threads     ForumThread[]
}

model ForumThread {
  id         String        @id @default(cuid())
  categoryId String
  category   ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  authorId   String
  author     User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title      String
  body       String
  pinned     Boolean       @default(false)
  locked     Boolean       @default(false)
  hidden     Boolean       @default(false)
  createdAt  DateTime      @default(now())
  lastPostAt DateTime      @default(now())

  posts   ForumPost[]
  reports ForumReport[]

  @@index([categoryId, lastPostAt])
}

model ForumPost {
  id        String      @id @default(cuid())
  threadId  String
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  hidden    Boolean     @default(false)
  createdAt DateTime    @default(now())

  reports ForumReport[]

  @@index([threadId, createdAt])
}

model ForumReport {
  id         String       @id @default(cuid())
  reporterId String
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  threadId   String?
  thread     ForumThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  postId     String?
  post       ForumPost?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  reason     String
  resolved   Boolean      @default(false)
  createdAt  DateTime     @default(now())
}

/// Juego interactivo autocontenido (un archivo HTML). Se sirve aislado en un
/// iframe con sandbox, solo para suscriptores.
model Game {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @default("")
  ageLabel    String   @default("")
  emoji       String   @default("🎲")
  color       String   @default("#3DAEE4")
  html        String
  /// true: el juego ocupa el alto de la pantalla y tiene su propio scroll
  /// (juegos por pantallas, con ventanas emergentes). false: el marco crece.
  fullHeight  Boolean  @default(false)
  /// true: libre y gratis para todos, sin cuenta ni suscripción.
  free        Boolean  @default(false)
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Servicios adicionales a la suscripción (asesoría, colegios, empresas,
/// sector público). Con precio fijo se compran en línea; si no, se cotizan.
model Service {
  id           String          @id @default(cuid())
  slug         String          @unique
  audience     ServiceAudience
  name         String
  description  String          @default("")
  details      String          @default("")
  /// Precio en dólares para la compra en línea; null = solo cotización.
  priceUsd     Int?
  /// Precio fijo en COP (opcional) para la compra en línea; si existe reemplaza la conversión.
  priceCop     Int?
  /// Rango de referencia en dólares; se muestra convertido a la moneda elegida.
  priceFromUsd Int
  priceToUsd   Int
  unit         String          @default("")
  featured     Boolean         @default(false)
  active       Boolean         @default(true)
  order        Int             @default(0)
  createdAt    DateTime        @default(now())

  orders   Order[]
  requests ServiceRequest[]
}

model ServiceRequest {
  id           String               @id @default(cuid())
  serviceId    String
  service      Service              @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId      String?              @unique
  name         String
  email        String
  phone        String               @default("")
  organization String               @default("")
  city         String               @default("")
  message      String               @default("")
  status       ServiceRequestStatus @default(NEW)
  adminNotes   String               @default("")
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([status, createdAt])
}

/// Configuración editable desde el admin (p. ej. tasas de cambio).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
