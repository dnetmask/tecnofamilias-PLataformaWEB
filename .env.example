# Base de datos Postgres (Neon desde el Marketplace de Vercel crea ambas variables)
DATABASE_URL="postgresql://usuario:clave@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:clave@host/db?sslmode=require"

# Secreto para firmar las sesiones: openssl rand -base64 32
AUTH_SECRET=""

# URL pública del sitio (sin barra final)
APP_URL="https://tecnofamilias.com"

# Pagos: "mercadopago" en producción, "demo" para pruebas sin cobro real
PAYMENTS_MODE="mercadopago"
MP_ACCESS_TOKEN=""
# Clave secreta de webhooks de Mercado Pago (opcional, recomendada)
MP_WEBHOOK_SECRET=""

# Correos (recuperación de contraseña) desde un buzón de Microsoft 365 con Microsoft Graph.
# App de Microsoft Entra con permiso de aplicación Mail.Send (consentimiento de administrador) y secreto de cliente.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Buzón que envía, p. ej. hola@tecnofamilias.com
MS_SENDER=
# Nombre visible del remitente (opcional, por defecto "Tecnofamilias")
EMAIL_FROM_NAME=

# PDF de la Caja de herramientas: almacén privado de Vercel Blob (Vercel crea la variable al conectarlo)
BLOB_READ_WRITE_TOKEN=

# Administrador inicial que crea `npm run db:seed`
ADMIN_EMAIL="admin@tecnofamilias.com"
ADMIN_PASSWORD=""
